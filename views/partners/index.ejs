<!doctype html>
<html lang="ja"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Mojidas 販売店ポータル</title><link rel="stylesheet" href="/stylesheets/mojidas-partners.css"><script src="/javascripts/mojidas-partners.js" defer></script></head>
<body><main<% if (admin) { %> data-admin-dynamic<% } else { %> data-partner-dynamic<% } %>><header><img src="/assets/mojidas-logo.png" alt="Mojidas"><h1><%= admin ? '販売店・法人利用管理' : '販売店ポータル' %></h1></header>
<% if (error) { %><p role="alert"><%= error %></p><% } %>
<% if (mode === 'login') { %>
<p>管理者から招待された販売店アカウントでログインしてください。</p>
<form method="post" action="/partners/login"><input type="hidden" name="csrfToken" value="<%= csrf %>"><label>メールアドレス<input type="email" name="email" required autocomplete="username"></label><label>パスワード<input type="password" name="password" required maxlength="128" autocomplete="current-password"></label><button>ログイン</button></form>
<% } else if (mode === 'accept') { %>
<h2>パスワードを設定</h2><form method="post" action="/partners/accept"><input type="hidden" name="csrfToken" value="<%= csrf %>"><input id="invite-id" type="hidden" name="id"><input id="invite-token" type="hidden" name="token"><label>パスワード（8〜128文字）<input type="password" name="password" minlength="8" maxlength="128" required autocomplete="new-password"></label><label>もう一度入力<input type="password" name="confirmPassword" minlength="8" maxlength="128" required autocomplete="new-password"></label><button>パスワードを設定</button></form>
<% } else { %>
<% if (admin) { %>
<p><a href="/admin/mojidas">Mojidas管理へ戻る</a></p>
<section>
  <div class="section-heading"><h2>販売店一覧</h2><button type="button" data-dialog-open="partner-invite">販売店を招待</button></div>
  <div class="table"><table><thead><tr><th>販売店名</th><th>メールアドレス</th><th>状態</th><th>操作</th></tr></thead><tbody>
  <% partners.forEach((p, index) => { %>
    <tr><td><%= p.name %></td><td><%= p.email %></td><td><%= ({ active: '有効', invited: '招待中', suspended: '停止' })[p.status] || p.status %></td><td><button type="button" class="secondary" data-dialog-open="partner-edit-<%= index %>">編集</button></td></tr>
  <% }); %>
  <% if (!partners.length) { %><tr><td colspan="4">登録された販売店はありません。</td></tr><% } %>
  </tbody></table></div>
</section>
<dialog id="partner-invite" aria-labelledby="partner-invite-title">
  <h2 id="partner-invite-title">販売店を招待</h2>
  <form method="post" action="<%= base %>/invite">
    <input type="hidden" name="csrfToken" value="<%= csrf %>">
    <label>販売店名<input name="name" maxlength="120" required></label>
    <label>メールアドレス<input type="email" name="email" maxlength="254" required></label>
    <div class="dialog-actions"><button type="button" class="secondary" data-dialog-close>キャンセル</button><button>招待メールを送信</button></div>
  </form>
</dialog>
<% partners.forEach((p, index) => { %>
<dialog id="partner-edit-<%= index %>" aria-labelledby="partner-edit-title-<%= index %>">
  <h2 id="partner-edit-title-<%= index %>">販売店を編集</h2>
  <form method="post" action="<%= base %>/edit">
    <input type="hidden" name="csrfToken" value="<%= csrf %>"><input type="hidden" name="id" value="<%= p.id %>">
    <label>販売店名<input name="name" value="<%= p.name %>" maxlength="120" required></label>
    <p>メールアドレス：<%= p.email %></p>
    <p>状態：<%= ({ active: '有効', invited: '招待中', suspended: '停止' })[p.status] || p.status %></p>
    <div class="dialog-actions"><button type="button" class="secondary" data-dialog-close>キャンセル</button><button>保存</button></div>
  </form>
</dialog>
<% }); %>
<p><button type="button" data-dialog-open="domain-application">法人ドメインを追加</button></p>
<dialog id="domain-application" aria-labelledby="domain-application-title">
  <h2 id="domain-application-title">法人ドメインを追加</h2>
  <form method="post" action="<%= base %>/domains">
    <p>追加すると法人利用が有効になります。サブドメインは個別に登録してください。</p>
    <input type="hidden" name="csrfToken" value="<%= csrf %>">
    <label>販売店<select name="partnerID" required><option value="" selected disabled>販売店を選択してください</option><% partners.filter(p => p.status === 'active').forEach(p => { %><option value="<%= p.id %>"><%= p.name %>（<%= p.email %>）</option><% }); %></select></label>
    <% if (!partners.some(p => p.status === 'active')) { %><p>先に販売店の招待とパスワード設定を完了してください。</p><% } %>
    <label>組織名<input name="organizationName" maxlength="160" required></label>
    <label>メールドメイン<input name="domain" placeholder="example.co.jp" maxlength="253" required></label>
    <div class="dialog-actions"><button type="button" class="secondary" data-dialog-close>キャンセル</button><button<%= partners.some(p => p.status === 'active') ? '' : ' disabled' %>>追加</button></div>
  </form>
</dialog>
<% } else { %>
<p><%= user.name %> — <%= user.email %></p>
<form method="post" action="/partners/logout"><input type="hidden" name="csrfToken" value="<%= csrf %>"><button class="secondary">ログアウト</button></form>
<% } %>
<section><h2>ドメイン別の利用時間</h2><form method="get" action="<%= base %>"><label>対象月（日本時間）<input name="month" type="month" value="<%= month %>" data-auto-month required></label></form><p>認識は発話時間、正式翻訳は対象時間の50％を集計します。今月は現在の利用期間、過去の月はその月のリセット日からの期間を表示します。利用報告を受信・確定した期間に計上します。時間は「時間:分:秒」（00:00:00）で表示します。</p>
<div class="table"><table><thead><tr><% if (admin) { %><th>販売店</th><% } %><th>組織・ドメイン</th><th>リアルタイム</th><th>ファイル</th><th>正式翻訳</th><th>合計</th><th>超過</th><th>操作</th></tr></thead><tbody>
<% const hours = value => { const seconds = Math.floor(Math.max(0, value) / 1000); return [Math.floor(seconds / 3600), Math.floor(seconds / 60) % 60, seconds % 60].map(part => String(part).padStart(2, '0')).join(':'); }; %>
<% rows.forEach((row, index) => { const u = row.usage; %><tr class="domain-usage-row<%= row.status === 'approved' ? '' : ' is-inactive' %>">
<% if (admin) { %><td><%= partners.find(p => p.id === row.partnerID)?.name || row.partnerID %></td><% } %>
<td><strong><%= row.organizationName %></strong><br><%= row.domain %><% if (row.periodStart != null) { %><br><small><%= new Date(row.periodStart).toLocaleDateString('ja-JP', { timeZone: 'Asia/Tokyo' }) %>〜<%= new Date(row.periodEnd - 1).toLocaleDateString('ja-JP', { timeZone: 'Asia/Tokyo' }) %></small><% } %></td><td><%= hours(u.realtime) %></td><td><%= hours(u.mediaFile) %></td><td><%= hours(u.formalTranslation) %></td><td><%= hours(u.realtime + u.mediaFile + u.formalTranslation) %></td>
<td><%= row.excessMilliseconds > 0 ? hours(row.excessMilliseconds) : '—' %></td>
<td><button type="button" class="secondary" data-dialog-open="domain-details-<%= index %>">詳細</button>
<% if (admin) { %><form method="post" action="<%= base %>/domains/status"><input type="hidden" name="csrfToken" value="<%= csrf %>"><input type="hidden" name="domain" value="<%= row.domain %>"><select name="status" required><option value="active"<%= row.status === 'approved' ? ' selected' : '' %>>有効</option><option value="inactive"<%= row.status !== 'approved' ? ' selected' : '' %>>無効</option></select><button>適用</button></form><% } %></td></tr><% }); %>
</tbody></table></div><% if (!rows.length) { %><p>登録されたドメインはありません。</p><% } %></section>
<section aria-labelledby="annual-usage-title">
  <div class="section-heading">
    <h2 id="annual-usage-title">月別の利用時間 — <%= year %>年</h2>
    <nav class="year-pagination" aria-label="利用時間の年切り替え">
      <form method="get" action="<%= base %>"><input type="hidden" name="month" value="<%= month %>"><input type="hidden" name="year" value="<%= year - 1 %>"><button class="secondary" <%= year <= 2000 ? 'disabled' : '' %>>← 前年</button></form>
      <form method="get" action="<%= base %>"><input type="hidden" name="month" value="<%= month %>"><input type="hidden" name="year" value="<%= year + 1 %>"><button class="secondary" <%= year >= 9999 ? 'disabled' : '' %>>翌年 →</button></form>
    </nav>
  </div>
  <p>1月から12月までの暦月（日本時間）の実績です。上限判定のリセット期間とは異なり、利用報告を受信・確定した月に計上します。</p>
    <label for="annual-organization">組織</label>
    <select id="annual-organization" data-annual-organization>
      <option value="">組織を選択してください</option>
      <% annualRows.forEach(row => { %><option value="<%= row.domain %>"><%= row.organizationName %>（<%= row.domain %>）</option><% }); %>
    </select>
    <p data-annual-empty>組織を選択すると月別の利用時間を表示します。</p>
  <% annualRows.forEach(row => { %>
    <div data-annual-domain="<%= row.domain %>" hidden>
    <h3><%= row.organizationName %>（<%= row.domain %>）</h3>
    <% if (admin) { %><p>販売店：<%= partners.find(p => p.id === row.partnerID)?.name || row.partnerID %></p><% } %>
    <div class="table"><table>
      <thead><tr><th>月</th><th>リアルタイム</th><th>ファイル</th><th>正式翻訳</th><th>合計</th></tr></thead>
      <tbody><% row.months.forEach(item => { %><tr><th scope="row"><%= item.month %>月</th><td><%= hours(item.realtime) %></td><td><%= hours(item.mediaFile) %></td><td><%= hours(item.formalTranslation) %></td><td><%= hours(item.total) %></td></tr><% }); %></tbody>
      <tfoot><tr><th scope="row">年間合計</th><td><%= hours(row.months.reduce((sum, item) => sum + item.realtime, 0)) %></td><td><%= hours(row.months.reduce((sum, item) => sum + item.mediaFile, 0)) %></td><td><%= hours(row.months.reduce((sum, item) => sum + item.formalTranslation, 0)) %></td><td><%= hours(row.total) %></td></tr></tfoot>
    </table></div>
    </div>
  <% }); %>
  <% if (!annualRows.length) { %><p>登録されたドメインはありません。</p><% } %>
</section>
<% rows.forEach((row, index) => { %>
<dialog id="domain-details-<%= index %>" aria-labelledby="domain-details-title-<%= index %>">
  <h2 id="domain-details-title-<%= index %>">ドメインの詳細</h2>
  <form method="post" action="<%= base %>/domains/edit">
    <input type="hidden" name="csrfToken" value="<%= csrf %>">
    <input type="hidden" name="domain" value="<%= row.domain %>">
    <input type="hidden" name="month" value="<%= month %>">
    <p><%= row.domain %></p>
    <label>組織名<input name="organizationName" value="<%= row.organizationName %>" maxlength="160" required></label>
    <label>連絡先メールアドレス<input type="email" name="contactEmail" value="<%= row.contactEmail || '' %>" maxlength="254"></label>
    <label>備考<textarea name="notes" rows="5" maxlength="5000"><%= row.notes || '' %></textarea></label>
    <label>上限（時間）<input type="number" name="limitHours" min="0" step="0.01" value="<%= row.limitMilliseconds == null ? '' : row.limitMilliseconds / 3600000 %>" placeholder="空欄は上限なし"></label>
    <label>毎月のリセット日<input type="number" name="resetDay" min="1" max="31" step="1" value="<%= row.resetDay || 1 %>" required></label>
    <p>日本時間の指定日0時にリセットします。指定日がない月は月末です。リセット日を変更すると、その日付による期間で利用時間を再集計します。</p>
    <label class="checkbox"><input type="checkbox" name="stopAtLimit" <%= row.stopAtLimit ? 'checked' : '' %>>上限に達したら利用不可にする</label>
    <label class="checkbox"><input type="checkbox" name="notifyAtOneHour" <%= row.notifyAtOneHour ? 'checked' : '' %>>残り1時間で連絡先と販売店にメールで通知する</label>
    <p>通知は利用報告の受信時に判定します。報告間隔・メール配送分の遅れがあります。認識中の停止も報告時の判定となり、超過する場合があります。</p>
    <div class="dialog-actions"><button type="button" class="secondary" data-dialog-close>キャンセル</button><button>保存</button></div>
  </form>
</dialog>
<% }); %>
<% } %></main></body></html>
