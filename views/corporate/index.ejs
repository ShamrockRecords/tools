<!doctype html>
<html lang="ja">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>法人向けポータル | Mojidas</title><link rel="stylesheet" href="/stylesheets/mojidas-corporate.css"></head>
<body><script src="/javascripts/mojidas-corporate.js" defer></script><main>
  <header><a class="brand" href="/corporate"><img src="/assets/mojidas-logo.png" alt="Mojidas" width="160"></a><h1>法人向けポータル</h1>
  <% if (user) { %><details class="user-menu"><summary><%= user.email %></summary><nav aria-label="ユーザーメニュー">
    <% if (!user.mustChangePassword) { %><a href="/corporate/password">パスワードの変更</a><% } %>
    <form method="post" action="/corporate/logout"><input type="hidden" name="csrfToken" value="<%= csrf %>"><button>ログアウト</button></form>
  </nav></details><% } %></header>
  <% if (error) { %><p class="error" role="alert"><%= error %></p><% } %>
  <% if (mode === 'login') { %>
  <section class="auth-card"><h2>ログイン</h2><p>法人向けプランをご利用の管理者の方は、こちらからログインしてください。利用状況の確認や、法人プランの対象アカウントを管理できます。</p>
    <p class="help">※ Mojidasアプリのアカウントとは別の、法人向けポータル専用アカウントです。初めてログインする場合は、案内メールをご確認ください。</p>
    <form method="post" action="/corporate/login"><input type="hidden" name="csrfToken" value="<%= csrf %>">
      <label>メールアドレス<input name="email" type="email" autocomplete="username" maxlength="254" required></label>
      <label>パスワード<input name="password" type="password" autocomplete="current-password" maxlength="128" required></label><button>ログイン</button>
    </form>
    <p><a href="/corporate/forgot-password">パスワードをお忘れの方</a></p>
  </section>
  <% } else if (mode === 'verify') { %>
  <section class="auth-card"><h2>メールアドレスの認証</h2><p><%= user.email %> に届いた6桁のコードを入力してください。有効期限は10分です。認証後にパスワードを変更します。</p>
    <form method="post" action="/corporate/verify"><input type="hidden" name="csrfToken" value="<%= csrf %>">
      <label>認証コード<input name="code" inputmode="numeric" autocomplete="one-time-code" pattern="[0-9]{6}" minlength="6" maxlength="6" required></label><button>認証する</button>
    </form>
    <form method="post" action="/corporate/resend"><input type="hidden" name="csrfToken" value="<%= csrf %>"><button class="secondary">コードを再送（1分間隔）</button></form>
  </section>
  <% } else if (mode === 'password' || mode === 'initial-password') { %>
  <section class="auth-card"><h2><%= mode === 'initial-password' ? '初回パスワードの設定' : 'パスワードの変更' %></h2><p>12〜128文字の、これまでと異なるパスワードを設定してください。変更後、他の端末のログインは無効になります。</p>
    <form method="post" action="/corporate/password"><input type="hidden" name="csrfToken" value="<%= csrf %>">
      <% if (mode === 'password') { %><label>現在のパスワード<input name="currentPassword" type="password" autocomplete="current-password" maxlength="128" required></label><% } %>
      <label>新しいパスワード<input name="password" type="password" autocomplete="new-password" minlength="12" maxlength="128" required></label>
      <label>新しいパスワード（確認）<input name="confirmPassword" type="password" autocomplete="new-password" minlength="12" maxlength="128" required></label><button>パスワードを保存</button>
    </form><% if (mode === 'password') { %><a href="/corporate">ダッシュボードへ戻る</a><% } %>
  </section>
  <% } else { %>
  <section><h2>ダッシュボード</h2><p>法人プランの利用状況と対象アカウントを管理できます。</p>
  <div class="domain-grid"><% rows.forEach(row => { %><article class="domain-card"><h3><%= row.organizationName %></h3><dl>
    <dt>ドメイン</dt><dd><%= row.domain %></dd><dt>プラン</dt><dd><%= ({trial:'トライアル',metered:'従量制',light:'ライト',standard:'スタンダード',custom:'カスタム'})[row.plan] || row.plan %></dd>
    <dt>状態</dt><dd><%= ({ active: '有効', inactive: '無効', scheduled: '開始前' })[row.status] || '無効' %></dd></dl>
  </article><% }) %></div><% if (!rows.length) { %><p>現在、このアカウントに紐づく法人ドメインはありません。管理者へお問い合わせください。</p><% } %>
  </section>
  <% if (overview) { const o = overview; const hours = ms => (ms / 3600000).toLocaleString('ja-JP', { maximumFractionDigits: 2 }); const yen = value => value == null ? '個別契約' : value.toLocaleString('ja-JP', { maximumFractionDigits: 1 }) + '円'; const pageURL = page => '/corporate?' + new URLSearchParams({ domain: o.domain, month: o.month, q: o.query, page: String(page) }); %>
  <section class="management-section">
    <h2>利用状況</h2>
    <form method="get" action="/corporate" class="filters">
      <label>法人ドメイン<select name="domain"><% rows.forEach(row => { %><option value="<%= row.domain %>" <%= row.domain === o.domain ? 'selected' : '' %>><%= row.organizationName %>（<%= row.domain %>）</option><% }) %></select></label>
      <label>対象月（日本時間）<input type="month" name="month" value="<%= o.month %>" required></label><button>表示</button>
    </form>
    <p><%= o.plan === 'trial' ? 'トライアルは対象月ではなく、有効期間全体の利用を集計します。' : '選択した暦月の利用を集計します。月途中の開始でも上限は日割りしません。' %></p>
    <div class="metrics">
      <article><h3>合計利用時間</h3><strong><%= hours(o.quota.usedMilliseconds) %> 時間</strong><p>リアルタイム <%= hours(o.usage.realtime) %> ／ ファイル <%= hours(o.usage.mediaFile) %> ／ 正式翻訳 <%= hours(o.usage.formalTranslation) %> 時間</p></article>
      <article><h3><%= o.plan === 'trial' ? '有効期間内の上限' : '月間上限' %></h3><strong><%= o.quota.limitMilliseconds == null ? '上限なし' : hours(o.quota.limitMilliseconds) + ' 時間' %></strong><p>超過 <%= hours(o.quota.excessMilliseconds) %> 時間</p></article>
      <article><h3>料金概算（税込）</h3><strong><%= yen(o.estimate.total) %></strong><p>月額 <%= yen(o.estimate.base) %> ／ 超過分 <%= yen(o.estimate.excess) %></p></article>
    </div>
    <p class="help">正式翻訳は対象時間の50％を利用時間として表示します。利用報告の受信・確定時点で集計されます。料金は現在のプランを選択月に適用した参考額で、確定請求額ではありません。トライアルは無料、その他の超過は月合計を1分単位に切り上げて5.5円／分で計算（円の端数は保持）します。月額の日割りは含みません。カスタムの月額・合計は個別契約です。</p>
  </section>
  <section class="management-section">
    <h2>新しくログインしたアカウントの扱い</h2>
    <p>「無効」は法人プランの対象から外す設定です。アプリへのログインは禁止せず、新しい利用は個人の利用枠になります。進行中の法人利用は次の利用確認・報告で停止します。</p>
    <form method="post" action="/corporate/member-policy" class="policy-form">
      <input type="hidden" name="csrfToken" value="<%= csrf %>"><input type="hidden" name="domain" value="<%= o.domain %>"><input type="hidden" name="month" value="<%= o.month %>">
      <label class="auto-enable-label"><input type="checkbox" class="member-checkbox" data-auto-enable <%= o.autoEnable ? 'checked' : '' %>>自動で有効にする</label>
      <p class="help">チェックすると、同じドメインの新しいアカウントを法人プランの対象として有効にします。チェックしない場合は無効で一覧に追加され、管理者が後から有効にできます。既に一覧にあるアカウントの状態は変わりません。変更は自動保存されます。</p>
      <p data-policy-status role="status" aria-live="polite"></p>
    </form>
    <h3>アカウント一覧</h3>
    <form method="get" action="/corporate" class="filters">
      <input type="hidden" name="domain" value="<%= o.domain %>"><input type="hidden" name="month" value="<%= o.month %>">
      <label>メールアドレスで検索<input type="search" name="q" value="<%= o.query %>" maxlength="254" placeholder="メールアドレスの一部"></label><button>検索</button>
    </form>
    <p>全 <%= o.totalAccounts %> 件 ／ 検索結果 <%= o.matches %> 件 ／ <%= o.page %> / <%= o.pages %> ページ</p>
    <form id="bulk-members" method="post" action="/corporate/members">
      <input type="hidden" name="csrfToken" value="<%= csrf %>"><input type="hidden" name="domain" value="<%= o.domain %>"><input type="hidden" name="month" value="<%= o.month %>"><input type="hidden" name="q" value="<%= o.query %>"><input type="hidden" name="page" value="<%= o.page %>">
      <div class="bulk-actions"><button name="action" value="enable">選択したアカウントを有効にする</button><button class="secondary" name="action" value="disable">選択したアカウントを無効にする</button></div>
    </form>
    <div class="table-scroll"><table><thead><tr><th>選択</th><th>メールアドレス</th><th>法人プラン対象</th><th>利用時間</th><th>操作</th></tr></thead><tbody>
      <% o.users.forEach(u => { %><tr>
        <td><input class="member-checkbox" type="checkbox" name="userIDs" value="<%= u.uid %>" form="bulk-members" aria-label="<%= u.email %> を選択"></td>
        <td><%= u.email %><% if (!u.verified || u.disabled) { %><br><small>別途、<%= u.disabled ? 'アカウントが停止中' : 'メール認証が必要' %>です</small><% } %></td>
        <td><span class="<%= u.enabled ? 'enabled' : 'muted' %>"><%= u.enabled ? '有効' : '無効' %></span><br><small><%= u.explicit ? '個別設定' : '初期設定' %></small></td>
        <td><%= hours(u.used) %> 時間</td>
        <td><form method="post" action="/corporate/members"><input type="hidden" name="csrfToken" value="<%= csrf %>"><input type="hidden" name="domain" value="<%= o.domain %>"><input type="hidden" name="month" value="<%= o.month %>"><input type="hidden" name="q" value="<%= o.query %>"><input type="hidden" name="page" value="<%= o.page %>"><input type="hidden" name="userIDs" value="<%= u.uid %>"><button name="action" value="<%= u.enabled ? 'disable' : 'enable' %>" class="secondary"><%= u.enabled ? '無効にする' : '有効にする' %></button></form></td>
      </tr><% }) %>
      <% if (!o.users.length) { %><tr><td colspan="5">該当するアカウントはありません。</td></tr><% } %>
    </tbody></table></div>
    <nav class="pagination" aria-label="アカウント一覧のページ"><% if (o.page > 1) { %><a href="<%= pageURL(o.page - 1) %>">← 前へ</a><% } %><% if (o.page < o.pages) { %><a href="<%= pageURL(o.page + 1) %>">次へ →</a><% } %></nav>
    <p class="help">利用時間は上の利用状況と同じ集計範囲です。無効にしても過去の利用は残ります。削除済み・別ドメインへ変更済みなど、一覧のアカウントに紐づかない利用：<%= hours(o.unattributed) %> 時間。</p>
  </section>
  <% } %>
  <% } %>
</main></body></html>
