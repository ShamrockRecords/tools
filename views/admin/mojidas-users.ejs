<!DOCTYPE html>
<html lang="ja">
<head>
	<%- include('../parts/head', {title: 'Mojidasユーザー管理'}) %>
	<style>
		body { background-color: #f8f9fa; min-height: 100vh; }
		.user-email { min-width: 15rem; }
		.credit-time { font-size: 0.875rem; font-variant-numeric: tabular-nums; }
		.table { font-size: 0.875rem; }
		.table .small, .table .badge, .table .btn { font-size: inherit; }
		.table .modal { font-size: 1rem; }
		.table .modal .btn-sm, .table .modal .input-group-sm > .btn { font-size: 0.875rem; }
	</style>
</head>
<body>
	<div class="container py-5">
		<div class="d-flex flex-column flex-md-row justify-content-between align-items-start align-items-md-center gap-3 mb-4">
			<div>
				<a href="/admin/mojidas" class="text-decoration-none small"><i class="bi bi-arrow-left"></i> Mojidas管理へ戻る</a>
				<h1 class="h3 fw-bold mt-2 mb-1">Mojidasユーザー管理</h1>
				<p class="text-muted mb-0">アカウントの作成日時が新しい順に20件ずつ表示します。</p>
			</div>
			<div class="text-muted small"><%= user.email || '管理者' %></div>
		</div>

		<% if (flash) { %>
			<div class="alert alert-<%= flash.type %>" role="alert"><%= flash.message %></div>
		<% } %>

        <% if (typeof statistics !== 'undefined' && statistics) { %>
          <%- include('parts/user-statistics', { statistics }) %>
        <% } %>

		<div class="alert alert-info d-flex gap-2 align-items-start" role="status">
			<i class="bi bi-info-circle mt-1"></i>
			<div>招待ユーザーに設定すると、アプリには「招待ユーザー・時間無制限」と表示され、時間追加の案内は表示されません。残時間の合計にはテスト用時間も含みます。</div>
		</div>

		<p class="small text-muted">残時間はアプリと同じ利用可能時間です（ファイル認識などで予約中の時間は除きます）。追加は決済を行わず、無償提供枠へ加算します。</p>
		<p class="small text-muted">アプリバージョンはOS別に最後のログイン・認証更新で確認した値です。現在起動中とは限りません。未対応の旧アプリなど、情報がない場合は「未取得」と表示します。</p>
		<%- include('parts/user-pagination', { page, pagination }) %>
		<div class="card shadow-sm overflow-hidden">
			<div class="table-responsive">
				<table class="table table-hover align-middle mb-0">
					<thead class="table-light">
						<tr>
							<th scope="col">アカウント</th>
							<th scope="col">種別</th>
							<th scope="col">状態</th>
							<th scope="col">バージョン</th>
							<th scope="col" class="text-end text-nowrap">毎月の無料</th>
							<th scope="col" class="text-end text-nowrap">有償購入</th>
							<th scope="col" class="text-end text-nowrap">無償提供</th>
							<th scope="col" class="text-end text-nowrap">合計</th>
							<th scope="col" class="text-end">操作</th>
						</tr>
					</thead>
					<tbody>
						<% if (!users.length) { %>
							<tr><td colspan="9" class="text-center text-muted py-5">ユーザーがいません。</td></tr>
						<% } %>
						<% users.forEach((account, index) => { %>
							<tr>
								<td class="user-email">
									<div class="fw-semibold text-break"><%= account.email || 'メールアドレス未設定' %></div>
                                    <div class="small text-muted">作成：<%= formatDate(account.createdAt) %></div>
								</td>
                                <td class="text-nowrap">
                                    <% if (account.invitedUnlimited) { %>
                                        <span class="badge rounded-pill bg-success text-white">招待</span>
                                    <% } %>
                                    <% if (account.isCorporate) { %>
                                        <span class="badge rounded-pill bg-primary text-white">法人</span>
                                    <% } else if (account.isCorporate === null) { %>
                                        <span class="small text-danger">法人判定を取得できませんでした</span>
                                    <% } %>
                                </td>
								<td>
									<% if (account.disabled) { %>
										<span class="badge bg-secondary text-white">無効</span>
									<% } else { %>
										<span class="badge bg-success text-white">有効</span>
									<% } %>
								</td>
                                <td class="text-nowrap">
                                    <% if (account.appClients === null) { %>
                                        <span class="text-danger">バージョン情報を取得できませんでした</span>
                                    <% } else { %>
                                        <% [['macos', 'Mac'], ['windows', 'Windows']].forEach(([platform, label]) => { const client = account.appClients?.[platform]; %>
                                            <div><%= label %>：<%= client?.version || '未取得' %></div>
                                        <% }) %>
                                    <% } %>
                                </td>
                                <% ['monthlyFreeMilliseconds', 'purchasedMilliseconds', 'promotionalMilliseconds', 'totalMilliseconds'].forEach((field) => { %>
                                    <td class="text-nowrap text-end">
                                        <% if (!(field === 'totalMilliseconds' && account.invitedUnlimited)) { %>
                                        <% if (account.credit) { %>
                                            <div class="credit-time <%= field === 'totalMilliseconds' ? 'fw-semibold' : '' %>"><%= formatCreditTime(account.credit[field] || 0) %></div>
                                            <% if (field === 'totalMilliseconds' && account.credit.otherMilliseconds > 0) { %>
                                                <div class="small text-muted">うちその他（テスト等）：<%= formatCreditTime(account.credit.otherMilliseconds) %></div>
                                            <% } %>
                                        <% } else { %>
                                            <span class="text-danger" title="残時間を取得できませんでした">取得失敗</span>
                                        <% } %>
                                        <% } %>
                                    </td>
                                <% }) %>
                                <td class="text-end">
                                  <button type="button" class="btn btn-outline-secondary text-nowrap" data-bs-toggle="modal" data-bs-target="#user-settings-<%= index %>">設定</button>
                                  <div class="modal fade text-start" id="user-settings-<%= index %>" tabindex="-1" aria-labelledby="user-settings-title-<%= index %>" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered"><div class="modal-content">
                                      <div class="modal-header">
                                        <h2 class="modal-title h5" id="user-settings-title-<%= index %>">アカウント設定</h2>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="閉じる"></button>
                                      </div>
                                      <div class="modal-body">
                                        <p class="fw-semibold text-break"><%= account.email || 'メールアドレス未設定' %></p>
                                        <h3 class="h6">無償時間を追加</h3>
                                    <form method="post" action="/admin/mojidas-users/<%= encodeURIComponent(account.uid) %>/promotional-hours">
                                        <input type="hidden" name="csrfToken" value="<%= csrfToken %>">
                                        <input type="hidden" name="page" value="<%= page %>">
                                        <input type="hidden" name="operationID" value="<%= createOperationID() %>">
                                        <input type="text" name="reason" maxlength="200" class="form-control form-control-sm mb-1" placeholder="用途（例：プロモーション）" aria-label="無償提供の用途">
                                        <div class="input-group input-group-sm">
                                            <input type="number" name="hours" min="1" max="100000" step="1" required class="form-control" aria-label="<%= account.email || account.uid %>に無償で追加する時間">
                                            <span class="input-group-text">時間</span>
                                            <button type="submit" class="btn btn-primary">無償時間を追加</button>
                                        </div>
                                    </form>
                                    <hr class="my-4">
                                    <h3 class="h6">招待ユーザー</h3>
									<form method="post" action="/admin/mojidas-users/<%= encodeURIComponent(account.uid) %>/invited-unlimited">
										<input type="hidden" name="csrfToken" value="<%= csrfToken %>">
										<input type="hidden" name="page" value="<%= page %>">
										<input type="hidden" name="enabled" value="<%= account.invitedUnlimited ? 'false' : 'true' %>">
										<button class="btn <%= account.invitedUnlimited ? 'btn-success' : 'btn-outline-secondary' %>" type="submit">
											<i class="bi <%= account.invitedUnlimited ? 'bi-infinity' : 'bi-person-plus' %>"></i>
											<%= account.invitedUnlimited ? '招待ユーザーを解除' : '招待ユーザーにする' %>
										</button>
									</form>
                                      </div>
                                      <div class="modal-footer"><button type="button" class="btn btn-secondary" data-bs-dismiss="modal">閉じる</button></div>
                                    </div></div>
                                  </div>
								</td>
							</tr>
						<% }) %>
					</tbody>
				</table>
			</div>
		</div>

		<%- include('parts/user-pagination', { page, pagination }) %>
	</div>
</body>
</html>
